# Optional Next.js server-side API destination. Defaults to this address.
# For local development export this variable in the shell starting Next.js.
API_BASE_URL=http://127.0.0.1:8000
# API process only. fixture (default), simulation (offline synthetic), bidcars (disabled).
# Export in the API's shell before startup; the API does not automatically read this file.
AUCTION_PROVIDER=fixture
# Optional Playwright system Chromium; otherwise install with npx playwright install chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# No API keys, accounts, or commercial provider credentials are required in these offline modes.
# Optional local vision. These are API-process settings; this file is not auto-loaded.
# Start a trusted local Ollama service separately with OLLAMA_NO_CLOUD=1.
# This does not install/download a model or enable a hosted AI service.
LOCAL_VISION_ENABLED=0
LOCAL_VISION_MODEL=qwen3-vl:2b
# The explicit manufacturer-lookup action uses the free official NHTSA vPIC service.
# It sends the entered VIN only, and does not verify auction identity or vehicle history.
